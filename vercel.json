{
  "version": 2,
  "functions": {
    "api/**/*.js": {
      "maxDuration": 15
    }
  },
  "routes": [
    { "src": "/api/options/([^/]+)", "dest": "/api/options?symbol=$1" },
    { "src": "/api/quote/([^/]+)",   "dest": "/api/quote?symbol=$1"   },
    { "src": "/api/(.*)",            "dest": "/api/$1"                 },
    { "src": "/app\\.js",            "dest": "/app.js"                 },
    { "src": "/style\\.css",         "dest": "/style.css"              },
    { "src": "/(.*)",                "dest": "/index.html"             }
  ]
}


